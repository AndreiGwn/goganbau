// Cloudflare Workers deploy: serves the built static site from dist/ (build: npm run build).
{
    "name": "goganbau",
    "compatibility_date": "2026-10-01",
    "assets": {
        "directory": "./dist",
        // Unknown URLs get dist/404.html with status 404, like on GitHub Pages.
        "not_found_handling": "404-page"
    }
}
